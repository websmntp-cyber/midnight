{
  "buildCommand": "node scripts/build-theme.mjs",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index?__p=:path*" },
    { "source": "/a/:key", "destination": "/_admin/index.html" },
    { "source": "/a/:key/", "destination": "/_admin/index.html" }
  ],
  "headers": [
    { "source": "/a/(.*)", "headers": [
      { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
      { "key": "Cache-Control", "value": "no-store" },
      { "key": "Referrer-Policy", "value": "no-referrer" } ] },
    { "source": "/_admin/(.*)", "headers": [ { "key": "X-Robots-Tag", "value": "noindex, nofollow" } ] },
    { "source": "/assets/theme.css", "headers": [ { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" } ] },
    { "source": "/assets/(.*)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=3600" } ] },
    { "source": "/", "headers": [ { "key": "Cache-Control", "value": "no-cache" } ] }
  ]
}
